# Copia este archivo como .env.local y pon los datos de tu proyecto de Supabase
# (Supabase > Project Settings > API). Sin ellos la app funciona en modo invitado (solo este navegador).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Botones de login a mostrar (los que actives en Supabase > Authentication > Providers)
VITE_AUTH_PROVIDERS=github
